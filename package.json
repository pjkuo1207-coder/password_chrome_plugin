{
  "name": "smartpass-extension",
  "version": "0.1.0",
  "description": "SmartPass — a privacy-first Chrome extension for smart password generation with DOM-aware rule matching.",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
