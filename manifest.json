{
  "manifest_version": 3,
  "name": "SmartPass — Smart Password Generator",
  "version": "0.1.0",
  "description": "Privacy-first password generator with smart DOM rule matching, passphrase/pronounceable modes, and auto-clearing clipboard. Fully offline.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
